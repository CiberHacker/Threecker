    <!-- About tab -->
    <string name="about_lead">Read, save and restore the memory of a Moscow Troika card (sectors 8 and 9).</string>
    <string name="about_body">Threecker talks to the MIFARE Classic chip over NFC: it reads sector 8 and sector 9, decodes the card number, balance, last usage time and validator, and keeps every read as a dump. Writing sends a stored dump back to the same card and verifies it afterwards.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_safety_title">Before you write</string>
    <string name="about_safety_body">Keep balances under 100 RUB. Never enter the metro twice with the same last usage time — after writing a dump, refresh the time on a ground transport validator. Only phones with an NXP NFC chip can read Troika cards.</string>
